--!strict
--[[
	Lists the parts of every authored slime model (READ-ONLY: writes nothing, prints Markdown).

	Usage:
		lune run scripts/list-slime-parts assets.rbxl > docs/docs/SLIME-PARTS.md
		lune run scripts/list-slime-parts assets/SlimeModels.rbxm

	Accepts a place file (.rbxl) or an exported ReplicatedStorage.SlimeModels folder (.rbxm). The table shows,
	per slime, its face type and its accessory group (Acc_*) with the part / node names CatchFx can target
	(SlimeFactory.SetPartMotion / FindParts keys).
]]

local fs = require("@lune/fs")
local process = require("@lune/process")
local roblox = require("@lune/roblox")

local GameConfig = require("../src/ReplicatedStorage/Shared/GameConfig")

local FACTORY_PATH = "src/ReplicatedStorage/Shared/SlimeFactory.luau"

-- SlimeId -> { zone, name } from SlimeFactory's MODEL_PATHS (same parser as check-slime-models)
local function parseModelPaths(): { [string]: { zone: string, name: string } }
	local paths = {}
	local inTable = false
	for line in string.gmatch(fs.readFile(FACTORY_PATH), "[^\n]+") do
		if string.find(line, "^local MODEL_PATHS") then
			inTable = true
		elseif inTable and string.find(line, "^}") then
			break
		elseif inTable then
			local id, zone, name = string.match(line, '^%s*([%w_]+)%s*=%s*{%s*"([^"]+)"%s*,%s*"([^"]+)"%s*}')
			if id and zone and name then
				paths[id] = { zone = zone, name = name }
			end
		end
	end
	return paths
end

local function loadRoot(path: string): any
	if string.match(path, "%.rbxmx?$") then
		for _, inst in roblox.deserializeModel(fs.readFile(path)) do
			if inst.Name == "SlimeModels" then
				return inst
			end
		end
		return nil
	end
	local game = roblox.deserializePlace(fs.readFile(path))
	return game:GetService("ReplicatedStorage"):FindFirstChild("SlimeModels")
end

local function main()
	local path = process.args[1]
	if not path or not fs.isFile(path) then
		print("Usage: lune run scripts/list-slime-parts assets.rbxl")
		process.exit(1)
	end
	local root = loadRoot(path)
	if not root then
		print("ERROR: no SlimeModels folder found")
		process.exit(1)
	end
	local paths = parseModelPaths()

	print("# Slime model parts")
	print("")
	print(`Generated by \`lune run scripts/list-slime-parts {path}\`. Do not edit by hand.`)
	print("Every model: `Base/` (Body, Core, Outline, Highlight, HighlightSmall), one `Face_<Type>` group and one")
	print("`Acc_<Name>` accessory group. The accessory names below are the keys `CatchFx` / `SlimeFactory.SetPartMotion` use.")
	print("")
	print("| Slime | Model | Face | Accessory group | Accessory parts (nodes in brackets) |")
	print("|---|---|---|---|---|")
	for _, def in GameConfig.Slimes do
		local p = paths[def.Id]
		local holder = p and root:FindFirstChild(p.zone)
		holder = holder and holder:FindFirstChild(p.name)
		local slime = holder and holder:FindFirstChild("Slime")
		if not slime then
			print(`| {def.Id} | (missing) | | | |`)
			continue
		end
		local face = "?"
		local accName = "-"
		local partNames: { string } = {}
		local nodeNames: { string } = {}
		for _, child in slime:GetChildren() do
			if string.sub(child.Name, 1, 5) == "Face_" then
				face = string.sub(child.Name, 6)
			elseif string.sub(child.Name, 1, 4) == "Acc_" then
				accName = child.Name
				local seen: { [string]: boolean } = {}
				for _, d in child:GetDescendants() do
					if d:IsA("BasePart") and not seen[d.Name] then
						seen[d.Name] = true
						table.insert(partNames, d.Name)
					elseif d:IsA("Model") and not string.find(d.Name, "_Node$") and not seen[d.Name] then
						seen[d.Name] = true
						table.insert(nodeNames, d.Name)
					end
				end
			end
		end
		table.sort(partNames)
		table.sort(nodeNames)
		local nodes = if #nodeNames > 0 then ` ({table.concat(nodeNames, ", ")})` else ""
		print(`| {def.Id} | {p.zone}/{p.name} | {face} | {accName} | {table.concat(partNames, ", ")}{nodes} |`)
	end
end

main()
